    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@sentry/nextjs": "^8.35.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
