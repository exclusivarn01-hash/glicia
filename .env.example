# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
NEXTAUTH_SECRET=your-secret-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# PDF Worker (Railway)
PDF_WORKER_URL=https://your-pdf-worker.railway.app
PDF_WORKER_SECRET=your-internal-secret

# E2E Tests
E2E_TEST_USER_EMAIL=e2e-user-a@glicia-test.com
E2E_TEST_USER_PASSWORD=e2e-password-a
E2E_TEST_USER_B_EMAIL=e2e-user-b@glicia-test.com
E2E_TEST_USER_B_PASSWORD=e2e-password-b
E2E_DELETABLE_USER_EMAIL=e2e-deletable@glicia-test.com
E2E_DELETABLE_USER_PASSWORD=e2e-deletable-password
